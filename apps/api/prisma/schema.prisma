generator client {
  provider      = "prisma-client-js"
  /// `rhel-openssl-3.0.x` e o runtime das funcoes da Vercel. Sem ele o client
  /// gerado so traz o engine da maquina que rodou o build, e a funcao sobe sem
  /// conseguir falar com o banco.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  /// Inalcancavel pelo sync: a Pluggy nao tem "cartao de debito" — para ela um
  /// cartao de debito e a propria conta corrente a que esta preso. Este valor
  /// so chega aqui por `customType`, quando o usuario rotula a conta a mao.
  DEBIT_CARD
  INVESTMENT
}

enum ItemStatus {
  UPDATING
  UPDATED
  LOGIN_ERROR
  OUTDATED
  ERROR
}

enum SystemCategoryKey {
  TRANSFER
  UNCATEGORIZED
  BILL_PAYMENT
}

/// Fixa ou variavel. Fixa e o que se repete com o mesmo valor todo mes e nao
/// muda por decisao do dia: aluguel, mensalidade, assinatura. Variavel e o
/// resto. A distincao vive na categoria, e nao na transacao, porque e assim
/// que a pessoa pensa nela — "Moradia e fixa" — e porque o relatorio precisa
/// somar os dois grupos sem depender de a transacao ter sido marcada a mao.
enum CategoryKind {
  FIXED
  VARIABLE
}

enum SuggestionSource {
  HISTORY
  RULE
  PLUGGY
  /// Nenhuma fonte deu palpite. A linha existe assim mesmo: a fila de revisao
  /// e "toda transacao sem categoria", nao "toda transacao que o app adivinhou".
  NONE
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  CHANGED
  DISMISSED
}

enum HouseholdInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// O espaco em que categorias, orcamentos e metas vivem.
///
/// Todo usuario tem um desde o cadastro, mesmo sozinho: sem isso a fusao teria
/// de lidar com dois casos (tem espaco / nao tem) e toda leitura precisaria de
/// um fallback para `userId`.
model Household {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  members    User[]
  categories Category[]
  budgets    Budget[]
  goals      Goal[]
  invites    HouseholdInvite[]
}

/// Convite para entrar num espaco.
///
/// O e-mail e guardado ao lado do `inviteeId` para que o registro continue
/// legivel depois: quem convidou precisa ver para quem mandou, e nome e e-mail
/// do outro podem mudar.
///
/// O indice unico parcial `HouseholdInvite_pendente_por_par` (um convite
/// pendente por par householdId+inviteeId) vive so na migracao
/// `20260827194103_conta_conjunta/migration.sql` — PSL nao tem sintaxe para
/// indice parcial (`WHERE`), entao ele nao pode ser declarado aqui. Qualquer
/// migracao futura gerada por `prisma migrate dev` precisa preservar esse
/// indice manualmente, ou a guarda de concorrencia contra convite duplicado
/// some silenciosamente.
model HouseholdInvite {
  id           String                @id @default(uuid())
  householdId  String
  inviterId    String
  inviteeId    String
  inviteeEmail String
  status       HouseholdInviteStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  respondedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User      @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([householdId, status])
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  name               String
  /// Foto de perfil como data URL (base64). Enviada pelo app já redimensionada.
  avatarUrl          String?  @db.Text
  /// Credenciais da aplicação Pluggy do usuário. Ficam por usuário — e não no
  /// ambiente — para que cada conta fale com a Pluggy com a própria aplicação.
  /// O secret é guardado cifrado (AES-256-GCM, ver src/lib/crypto.ts).
  pluggyClientId     String?
  pluggyClientSecret String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  householdId        String

  items               Item[]
  accounts            Account[]
  transactions        Transaction[]
  notifications       Notification[]
  categorySuggestions CategorySuggestion[]
  creditCardBills     CreditCardBill[]
  goalsCreated        Goal[]
  household           Household            @relation(fields: [householdId], references: [id])
  invitesSent         HouseholdInvite[]    @relation("InvitesSent")
  invitesReceived     HouseholdInvite[]    @relation("InvitesReceived")

  @@index([householdId])
}

model Item {
  id                  String     @id @default(uuid())
  userId              String
  pluggyItemId        String     @unique
  institutionName     String
  /// Logo do conector, servida pela Pluggy (CDN). Pode ser sobrescrita por um
  /// arquivo local em apps/desktop/public/institutions/<slug>.(svg|png).
  institutionImageUrl String?
  /// Cor primária da marca informada pelo conector, usada como fundo do logo.
  institutionColor    String?
  /// Logo escolhida manualmente pelo usuário, como data URL (base64). Vive numa
  /// coluna separada de `institutionImageUrl` justamente para que o sync — que
  /// só escreve aquela — nunca sobrescreva a escolha do usuário.
  customImageUrl      String?    @db.Text
  status              ItemStatus @default(UPDATING)
  lastSyncedAt        DateTime?
  /// O webhook avisou que ha transacao nova nesta conexao, e o sync ainda nao
  /// rodou. E so um aviso na tela: o app nunca sincroniza sozinho, porque o
  /// tempo de uma funcao serverless nao comporta um sync de tamanho
  /// desconhecido disparado por evento externo.
  hasPendingSync      Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

model Account {
  id                  String       @id @default(uuid())
  userId              String
  itemId              String?
  pluggyAccountId     String?      @unique
  name                String
  /// Nome dado pelo usuário. Tem precedência sobre `name`, que o sync reescreve
  /// a cada atualização a partir dos dados da Pluggy.
  customName          String?
  type                AccountType
  balance             Decimal      @default(0) @db.Decimal(14, 2)
  /// Preferência de exibição: a conta sai dos cards de saldo do Dashboard e
  /// continua valendo em transações, relatórios e orçamentos.
  excludedFromBalance Boolean      @default(false)
  /// Tipo escolhido pelo usuario. Tem precedencia sobre `type`, que o sync
  /// reescreve a cada atualizacao a partir do que a Pluggy derivou. Mesma
  /// divisao de `name`/`customName`: o sync escreve uma coluna e nunca a outra.
  customType          AccountType?
  /// Dia do mes em que a fatura do cartao vence, 1 a 31. Semeado do
  /// `creditData.balanceDueDate` da Pluggy no primeiro contato e, dali em
  /// diante, so o usuario muda. E o que transforma o mes da fatura de uma
  /// parcela (`Transaction.billMonth`) numa data de vencimento — por isso mora
  /// na conta, e nao repetido em cada transacao: corrigir o dia aqui conserta
  /// todas as parcelas de uma vez.
  creditCardDueDay    Int?
  institutionName     String?
  lastSyncedAt        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  item            Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  goals           Goal[]
  creditCardBills CreditCardBill[]

  @@index([userId])
}

/// A fatura do cartao, como a instituicao a fecha.
///
/// Existe por duas razoes. A primeira e o `payments[]` que a Pluggy devolve: e
/// a propria instituicao dizendo que a fatura foi paga, em que dia e por quanto
/// — o unico jeito de reconhecer o debito na conta corrente sem adivinhar pela
/// descricao. A segunda e servir de ancora para `Transaction.pluggyBillId`.
///
/// Nunca vira linha de despesa. A despesa sao as compras; a fatura e o agregado
/// delas, e soma-la ao lado das transacoes contaria tudo duas vezes.
model CreditCardBill {
  id           String    @id @default(uuid())
  userId       String
  accountId    String
  pluggyBillId String    @unique
  dueDate      DateTime
  /// Quando a instituicao fechou a fatura. Nulo enquanto ela esta aberta.
  closingDate  DateTime?
  totalAmount  Decimal   @db.Decimal(14, 2)
  /// Data e valor do pagamento reportado pela instituicao. Nulos enquanto a
  /// fatura nao foi paga — e e a presenca deles que dispara o reconhecimento.
  paidAt       DateTime?
  paidAmount   Decimal?  @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([accountId])
}

model Category {
  id          String             @id @default(uuid())
  householdId String
  name        String
  icon        String
  colorKey    String
  /// Despesa fixa ou variavel. Toda categoria tem uma, inclusive as de receita:
  /// nao ha tipo na categoria, entao quem decide o que e fixo e o usuario.
  kind        CategoryKind       @default(VARIABLE)
  /// Marca as categorias que o app cria e mantém. Não aparecem em seletores,
  /// não podem ser renomeadas nem excluídas, e não aceitam orçamento. Existem
  /// para que nenhuma transação precise ficar com `categoryId` nulo.
  systemKey   SystemCategoryKey?
  createdAt   DateTime           @default(now())

  household    Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  suggestions  CategorySuggestion[] @relation("SuggestedCategory")

  @@unique([householdId, name])
  @@unique([householdId, systemKey])
}

model Transaction {
  id                  String          @id @default(uuid())
  userId              String
  accountId           String
  categoryId          String?
  pluggyTransactionId String?         @unique
  description         String
  amount              Decimal         @db.Decimal(14, 2)
  type                TransactionType
  date                DateTime
  note                String?
  isRecurring         Boolean         @default(false)
  /// Numero desta parcela e total de parcelas, como a Pluggy os entrega em
  /// `creditCardMetadata`. Os dois andam juntos: meia parcela nao e parcela, e
  /// quando so um dos dois vem, ambos ficam nulos.
  installmentIndex    Int?
  installmentTotal    Int?
  /// A fatura em que a linha cai, como "YYYY-MM". Vem do `billForecastDate` da
  /// Pluggy quando o conector e Open Finance; senao e derivado do mes da
  /// transacao. Nulo fora de cartao de credito.
  billMonth           String?
  /// O mes em que a transacao **conta** — o 1o dia dele, sempre. Igual a `date`
  /// para quase tudo; para transacao de cartao e o mes da fatura, porque e la
  /// que a despesa pesa no orcamento, e nao no dia da compra.
  ///
  /// Guarda o primeiro dia do mes, e nao o vencimento, de proposito: assim a
  /// coluna nao depende de `Account.creditCardDueDay`, e mudar o dia do cartao
  /// continua sem exigir backfill. A data de vencimento exibida segue derivada
  /// na leitura.
  ///
  /// Nao e nula porque nulo obrigaria cada consumidor a decidir o que fazer com
  /// a ausencia — o mesmo problema que `SystemCategoryKey` resolveu para
  /// `categoryId`.
  competenceDate      DateTime
  /// A data original da compra, quando a Pluggy a informa. Num parcelamento as
  /// N parcelas chegam com a mesma `date`, entao e isto que amarra as parcelas
  /// a uma compra — e o que permite dizer "comprado em 03/08" numa parcela que
  /// so vence em maio.
  purchaseDate        DateTime?
  /// Junta as parcelas de uma mesma compra. Derivada (ver lib/purchaseKey.ts),
  /// porque a Pluggy nao manda identificador de compra nenhum.
  purchaseKey         String?
  /// A fatura a que a Pluggy vinculou esta linha, quando ja vinculou. Chega
  /// vazio enquanto a fatura esta aberta (`status: PENDING`) e e preenchido no
  /// fechamento — e o evento `transactions/updated` que avisa.
  pluggyBillId        String?
  /// Une as duas pontas de uma transferência interna detectada. Torna o
  /// pareamento idempotente e permite desfazer nas duas pontas de uma vez.
  transferPairId      String?
  /// Une o estorno de uma compra parcelada as parcelas que ele cancela.
  ///
  /// Mesmo desenho do `transferPairId`: um uuid compartilhado por todas as
  /// pontas, o que torna o vinculo idempotente e o desfazer atomico. A ponta
  /// credito e uma linha INCOME; as outras sao as N parcelas EXPENSE.
  ///
  /// Fica fora de `camposDaTransacao` de proposito, e ha teste guardando isso:
  /// e o que impede o sync, o reparo e o webhook de desfazerem o que a pessoa
  /// resolveu a mao.
  compensationId      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  suggestion CategorySuggestion?

  @@index([userId, date])
  @@index([userId, competenceDate])
  @@index([categoryId])
  @@index([transferPairId])
  @@index([purchaseKey])
  @@index([pluggyBillId])
  @@index([compensationId])
}

model Budget {
  id           String   @id @default(uuid())
  householdId  String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId])
}

model Goal {
  id              String    @id @default(uuid())
  householdId     String
  /// Conta cujo saldo é o acumulado da meta. Obrigatória na API; nullable aqui
  /// para que excluir a conta não leve a meta junto — ela fica órfã e a UI pede
  /// que o usuário vincule outra.
  accountId       String?
  /// Quem criou a meta. E o que a dissolucao usa para decidir com quem ela
  /// fica: `accountId` nao serve, porque e anulavel de proposito e meta sem
  /// conta ficaria sem destino.
  createdByUserId String
  name            String
  targetAmount    Decimal   @db.Decimal(14, 2)
  targetDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([householdId])
  @@index([createdByUserId])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  body      String
  severity  NotificationSeverity @default(INFO)
  read      Boolean              @default(false)
  /// Rota do app para onde o item leva quando tocado. Null = só informativo.
  link      String?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model CategorySuggestion {
  id                 String           @id @default(uuid())
  userId             String
  transactionId      String           @unique
  /// Null quando nenhuma fonte deu palpite (`source = NONE`), e tambem quando a
  /// categoria sugerida foi excluida depois: nos dois casos a transacao continua
  /// na fila, so que pedindo uma escolha em vez de oferecer uma.
  categoryId         String?
  source             SuggestionSource
  /// 0..1. Em HISTORY é a fração do histórico daquele comerciante que caiu
  /// nesta categoria; em RULE e PLUGGY é um valor fixo. Em NONE, zero.
  confidence         Float
  status             SuggestionStatus @default(PENDING)
  /// Ligada quando o usuário desmarcou a transação na página daquela categoria:
  /// o palpite foi recusado à mão. A sugestão continua PENDING (a transação
  /// continua sem categoria), mas sem palpite — e a reavaliação que roda a cada
  /// lote aprovado tem de pular estas, ou devolveria na rodada seguinte
  /// exatamente o palpite que acabou de ser recusado.
  guessRejected      Boolean          @default(false)
  /// A categoria que o usuário de fato escolheu, quando trocou a sugerida.
  resolvedCategoryId String?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation("SuggestedCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

/// Contagem de tentativas por IP, para as rotas sem autenticacao.
///
/// Morava num `Map` de processo, sob a premissa — escrita no proprio arquivo —
/// de que "a API e um processo so". Em serverless isso deixa de valer: cada
/// instancia teria o seu mapa, as tentativas se espalhariam entre elas e o
/// limite viraria enfeite. No banco ha um contador so, que e o que a regra
/// sempre quis dizer.
model RateLimitHit {
  /// `escopo:ip`. O escopo separa limites diferentes sobre o mesmo IP.
  key     String   @id
  count   Int      @default(1)
  /// Quando a janela vira e a contagem recomeca.
  resetAt DateTime

  @@index([resetAt])
}
