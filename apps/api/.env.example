# Em serverless, use o endpoint *pooler* do Neon e limite o pool a 1 conexao:
# cada instancia da funcao abre o proprio pool, e varias instancias com pool
# grande esgotam o limite de conexoes do banco.
# ...?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

PLUGGY_BASE_URL="https://api.pluggy.ai"

# Chave de 32 bytes em base64 (gere com: openssl rand -base64 32)
APP_ENCRYPTION_KEY=""

JWT_SECRET=""
JWT_EXPIRES_IN="30d"

PORT=4000

# URL pública desta API, sem barra no fim. É para onde a Pluggy manda os
# webhooks — em desenvolvimento, o endereço de um túnel.
PUBLIC_API_URL=

# Segredo que a Pluggy devolve no header `x-poup-webhook-secret`. Gere um valor
# longo e aleatório; sem ele os webhooks não são registrados nem aceitos.
PLUGGY_WEBHOOK_SECRET=
